{
  "name": "carrot-royale",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:smoke": "npm run build && playwright test e2e/game-flow.spec.ts e2e/arena-switch-mid-match.spec.ts --grep-invert @flaky --workers=2 --retries=0",
    "test:all": "vitest run && playwright test",
    "clean": "node -e \"require('fs').rmSync('node_modules/.vite',{recursive:true,force:true});require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "perf:build": "tsc -b && vite build --sourcemap --outDir dist-perf",
    "perf": "node scripts/runPerfProfile.mjs"
  },
  "dependencies": {
    "@trystero-p2p/mqtt": "^0.23.0",
    "howler": "^2.2.4",
    "i18next": "^26.0.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.2",
    "trystero": "^0.23.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/howler": "^2.2.12",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "happy-dom": "^20.8.9",
    "playwright": "^1.58.2",
    "source-map": "^0.7.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.7",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=20.11"
  }
}
