{
  // NOTE: Not yet referenced from tsconfig.json. Wiring it into `references`
  // currently surfaces pre-existing type errors in scripts owned by other
  // areas (selfPlay.ts, generateNavData.ts, bench-netcode.ts, buildSfxLabPage.ts)
  // plus lib/types cascades in src (import.meta.env, DedicatedWorkerGlobalScope).
  // Add `{ "path": "./tsconfig.scripts.json" }` to tsconfig.json once those are
  // resolved (may also need "vite/client" in types and "WebWorker" in lib).
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["scripts/**/*.ts"]
}
